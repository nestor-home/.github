{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":automergeMinor"],
  "packageRules": [
    {
      "description": "npm releases wait a day, as pnpm's minimum release age does (pnpm 12 default): a fresher one would fail `pnpm install`. Nestor's own packages are exempt on both sides.",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["!@nestor-home/**"],
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Nestor's own packages follow each release, 0.x included, ahead of the hourly PR limit.",
      "matchPackageNames": ["nestor-home", "nestor-satellite", "@nestor-home/**"],
      "automerge": true,
      "prPriority": 10
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The server release a satellite SDK or template tests against.",
      "managerFilePatterns": ["/(^|/)\\.nestor-version$/"],
      "matchStrings": ["^(?<currentValue>\\S+)\\s*$"],
      "depNameTemplate": "nestor-home",
      "datasourceTemplate": "pypi",
      "depTypeTemplate": "devDependencies"
    },
    {
      "customType": "regex",
      "description": "The server release the site serves its schemas and OAuth relay from.",
      "managerFilePatterns": ["/^scripts/server\\.mjs$/"],
      "matchStrings": ["NESTOR_SERVER = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "nestor-home",
      "datasourceTemplate": "pypi",
      "depTypeTemplate": "dependencies"
    }
  ]
}
